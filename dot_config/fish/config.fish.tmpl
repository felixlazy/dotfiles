{{ if ne .chezmoi.os "darwin" }}
# brew
abbr p 'brew'
abbr pai 'brew install'
abbr par 'brew uninstall'
abbr pas 'brew search'
abbr pal 'brew list'
abbr paf 'brew list'
abbr pau 'brew upgrade'

abbr s "brew services list"
abbr sl "brew services list | grep started"
abbr sf "brew services list | grep error"
abbr sa "brew services start"
abbr so "brew services stop"
abbr sr "brew services restart"
abbr se "brew services start"
abbr sd "brew services stop"
   
fish_add_path /opt/homebrew/bin
