export PATH="/opt/homebrew/bin:$PATH"
#yazi
function y {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

export XDG_CONFIG_HOME="$HOME/.config"
export EZA_CONFIG_DIR="$HOME/.config/eza"
export EDITOR=nvim
export LANG=en_US.UTF-8
export BAT_CONFIG_PATH="$HOME/.config/bat/config"
export BAT_CONFIG_DIR="$HOME/.config/bat"

eval "$(zoxide init zsh)"
# eza
alias ls="eza --classify --color-scale --icons=always --group-directories-first --time-style iso"
alias ll="ls -long "
alias lsg="ls --git-ignore --git --git-repos "
alias llg="lsg --long "
alias ai="nvim -c 'terminal aichat'"
# zoxide
alias fz="__zoxide_zi"
# 设置代理
export https_proxy=http://127.0.0.1:7890 http_proxy=http://127.0.0.1:7890 all_proxy=socks5://127.0.0.1:7890

# fzf
source ~/.config/fzf/fzf.zsh
source <(fzf --zsh)

# lazygit
alias lg="lazygit"
alias lgf="lazygit -f"

alias mpvc='mpv --autofit=80%x80% --geometry=50%:50%'

source ~/.config/zsh/zinit.zsh
source ~/.config/zsh/television.zsh
source ~/.config/zsh/env.zsh

# --- History ---
# 历史记录文件的路径
HISTFILE=~/.zsh_history
# 内存中保留的历史记录数量
HISTSIZE=10000
# 保存到文件中的历史记录数量
SAVEHIST=10000
# 立即将命令附加到历史记录文件，而不是等待 shell 退出
setopt APPEND_HISTORY
# 在多个终端会话之间共享历史记录
setopt SHARE_HISTORY
# 如果在新会话中输入一个命令，它会立即被添加到历史记录文件中
setopt INC_APPEND_HISTORY
# 删除历史记录中的重复命令
setopt HIST_IGNORE_DUPS
# 删除历史记录中连续的重复命令
setopt HIST_IGNORE_ALL_DUPS
# 在历史记录中搜索时，忽略空格开头的命令
setopt HIST_IGNORE_SPACE
# 在历史记录中记录命令的执行时间
setopt EXTENDED_HISTORY
fastfetch
